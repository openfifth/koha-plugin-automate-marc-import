[% USE raw %]
[% USE Asset %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title>[% FILTER collapse %]
    [% t("Automate MARC Import") | html %] &rsaquo;
    [% t("Tools") | html %] &rsaquo;
    [% t("Koha") | html %]
[% END %]</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="tools_AutomateMarcImport" class="tools">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'cat-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/tools/tools-home.pl">Tools</a>
        [% END %]
        [% IF op == 'add_form' || op == 'edit_form' %]
            [% WRAPPER breadcrumb_item %]
                <a href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS %]&method=tool">Automate MARC Import</a>
            [% END %]
            [% WRAPPER breadcrumb_item bc_active = 1 %]
                <span>[% IF op == 'edit_form' %]Edit setting[% ELSE %]Add setting[% END %]</span>
            [% END %]
        [% ELSE %]
            [% WRAPPER breadcrumb_item bc_active= 1 %]
                <span>Automate MARC Import</span>
            [% END %]
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

<div class="main container-fluid">
    <div class="row">
        <div class="col-md-10 order-md-2 order-sm-1">
            <main>
                 [% IF op == 'add_form' || op == 'edit_form' %]
                     <h1>[% IF op == 'edit_form' %]Edit[% ELSE %]New[% END %] Automated MARC Import Setting</h1>
                    [% IF error_message %]
                        <div class="alert alert-danger">
                            <strong>Error:</strong> [% error_message | html %]
                        </div>
                    [% END %]
                    <form method="get" id="automate_marc_import_form">
                        <input type="hidden" name="class" value="[% CLASS %]"/>
                        <input type="hidden" name="method" value="[% METHOD %]"/>
                        <fieldset class="rows">
                            <legend>Identification</legend>
                            <ol>
                                <li>
                                    <label for="name" class="required">Name: </label>
                                    <input type="text" name="name" id="name" value="[% name | html %]" size="50" maxlength="100" required="required" />
                                    <span class="required">Required</span>
                                    <div class="hint">A short, descriptive name for this import setting (e.g., "Baker &amp; Taylor Weekly", "Ingram Daily Orders")</div>
                                </li>
                                <li>
                                    <label for="description">Description: </label>
                                    <textarea name="description" id="description" rows="3" cols="50" maxlength="500">[% description | html %]</textarea>
                                    <div class="hint">Optional. Provide additional details about the purpose of this setting or any special notes.</div>
                                </li>
                            </ol>
                        </fieldset>
                        <fieldset class="rows">
                            <legend>Transport ((S)FTP server)</legend>
                            <label for="selected_transport_id" class="required">Transport name: </label>
                            [% IF available_transport.count %]
                            <select name="selected_transport_id" id="selected_transport_id" class="select2 required" required="required">
                                <option value="">-- Select a transport --</option>
                                [% FOREACH transport IN available_transport %]
                                    <option value="[% transport.id %]"[% IF selected_transport_id == transport.id %] selected="selected"[% END %]>[% transport.name %]</option>
                                [% END %]
                            </select>
                            [% END %]
                            <span class="required">Required</span>
                            <div class="alert alert-info">
                                <p><strong>What is a transport?</strong> A transport defines the connection details for a remote server where your MARC files are stored (e.g., a vendor's FTP or SFTP server).</p>
                                [% IF available_transport.count %]
                                <p>Can't find the server you need? <a href="/cgi-bin/koha/admin/sftp_servers.pl?op=add_form">Add a new transport</a>.</p>
                                [% ELSE %]
                                <p>No transports have been configured yet. <a href="/cgi-bin/koha/admin/sftp_servers.pl?op=add_form">Add your first transport</a> to get started.</p>
                                [% END %]
                            </div>
                        </fieldset>
                        <fieldset class="rows">
                            <legend>Import profile</legend>
                            <div class="row">
                                <div class="col-sm-6">
                                    <label for="profile_id" class="required">Profile name: </label>
                                    <select name="profile_id" id="profile_id" class="select2 required" required="required">
                                        <option value="">-- Select a profile --</option>
                                        [% FOREACH profile IN available_profiles %]
                                        <option value="[% profile.id %]"[% IF profile_id == profile.id %] selected="selected"[% END %]>[% profile.name %]</option>
                                        [% END %]
                                    </select>
                                    <span class="required">Required</span>
                                    <div class="hint">Select a profile to see its import settings on the right.</div>
                                </div>
                                <div class="col-sm-6" id="profile_details_wrapper">
                                    <table style="margin:0" id="profile_details_table">
                                        <thead id="profile_details_thead">
                                            <th> Selected profile: details<th>
                                        </thead>
                                        <tbody id="profile_details_tbody">
                                            <tr>
                                                <td id="profile_details_header_name">Profile name:</td>
                                                <td id="name" class="profile_details_value"></td>
                                            </tr>
                                            <tr>
                                                <td id="profile_details_header_comment">Comments about this file:</td>
                                                <td id="comment" class="profile_details_value"></td>
                                            </tr>
                                            <tr>
                                                <td id="profile_details_header_record_type">Record type:</td>
                                                <td id="record_type" class="profile_details_value"></td>
                                            </tr>
                                            <tr>
                                                <td id="profile_details_header_encoding">Character encoding:</td>
                                                <td id="encoding" class="profile_details_value"></td>
                                            </tr>
                                            <tr>
                                                <td id="profile_details_header_format">Format:</td>
                                                <td id="format" class="profile_details_value"></td>
                                            </tr>
                                            <tr>
                                                <td id="profile_details_header_parse_items">Parse items:</td>
                                                <td id="parse_items" class="profile_details_value"></td>
                                            </tr>
                                            <tr>
                                                <td id="profile_details_header_marc_modification_template_id">MARC modification template:</td>
                                                <td id="template" class="profile_details_value"></td>
                                            </tr>
                                            <tr>
                                                <td id="profile_details_header_matcher">Record matching rule:</td>
                                                <td id="matcher" class="profile_details_value"></td>
                                            </tr>
                                            <tr>
                                                <td id="profile_details_header_nomatch_action">Action if matching record found:</td>
                                                <td id="nomatch_action" class="profile_details_value"></td>
                                            </tr>
                                            <tr>
                                                <td id="profile_details_header_overlay_action">Action if no match is found:</td>
                                                <td id="overlay_action" class="profile_details_value"></td>
                                            </tr>
                                            <tr>
                                                <td id="profile_details_header_item_action">How to process items:</td>
                                                <td id="item_action" class="profile_details_value"></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="alert alert-info">
                                <p><strong>What is an import profile?</strong> An import profile defines how MARC records should be processed: character encoding, record matching rules, and what to do with matching or non-matching records.</p>
                                [% IF available_profiles.count %]
                                <p>Can't find the profile you need? Create one by going to <a href="/cgi-bin/koha/tools/stage-marc-import.pl">Stage MARC records for import</a> and saving a new profile.</p>
                                [% ELSE %]
                                <p>No import profiles exist yet. Create one by going to <a href="/cgi-bin/koha/tools/stage-marc-import.pl">Stage MARC records for import</a> and saving a profile.</p>
                                [% END %]
                            </div>
                        </fieldset>
                        <fieldset class="rows">
                            <legend>File matching</legend>
                            <label for="filenames">Filename patterns (one per line): </label>
                            <textarea name="filenames">[% filenames | html %]</textarea>
                            <div class="hint">
                                Enter text patterns to match filenames from this server. For example, entering "dispatch" will match files like "dispatch1234.mrc" or "dispatch_weekly.mrc".
                            </div>
                            <div class="hint">
                                Matching is case-insensitive. You don't need to include file extensions.
                            </div>
                            <div class="alert alert-info">
                                <p><strong>Tip:</strong> Leave this field empty to make this profile the default for all files from this server that don't match any other setting.</p>
                            </div>
                        </fieldset>
                        <fieldset class="rows">
                            <legend>Import options</legend>
                            <ol>
                                <li>
                                    <label for="auto_commit">Auto-commit records: </label>
                                    <input type="checkbox" name="auto_commit" id="auto_commit" value="1"[% IF auto_commit %] checked="checked"[% END %] />
                                    <div class="hint">
                                        When enabled, records are automatically added to your catalog after staging.
                                    </div>
                                    <div class="hint">
                                        When disabled, records are staged for manual review before importing.
                                    </div>
                                </li>
                            </ol>
                            <fieldset id="framework_options" class="rows"[% UNLESS auto_commit %] style="display:none"[% END %]>
                                <legend>Framework options (for auto-commit)</legend>
                                <ol>
                                    <li>
                                        <label for="framework">New record framework:</label>
                                        <select name="framework" id="framework">
                                            <option value="">Default</option>
                                            [% FOREACH fw IN available_frameworks %]
                                                <option value="[% fw.frameworkcode | html %]"[% IF framework == fw.frameworkcode %] selected="selected"[% END %]>[% fw.frameworktext | html %]</option>
                                            [% END %]
                                        </select>
                                        <div class="hint">New bibliographic records will use this framework</div>
                                    </li>
                                    <li>
                                        <label for="overlay_framework">Replacement record framework:</label>
                                        <select name="overlay_framework" id="overlay_framework">
                                            <option value="_USE_ORIG_"[% IF overlay_framework == '_USE_ORIG_' || !overlay_framework %] selected="selected"[% END %]>Keep original framework</option>
                                            <option value=""[% IF overlay_framework == '' && overlay_framework.defined %] selected="selected"[% END %]>Default</option>
                                            [% FOREACH fw IN available_frameworks %]
                                                <option value="[% fw.frameworkcode | html %]"[% IF overlay_framework == fw.frameworkcode %] selected="selected"[% END %]>[% fw.frameworktext | html %]</option>
                                            [% END %]
                                        </select>
                                        <div class="hint">Replacement records will use this framework</div>
                                    </li>
                                </ol>
                            </fieldset>
                        </fieldset>
                         <fieldset class="action">
                             <input type="hidden" name="op" value="save" />
                             [% IF op == 'edit_form' %]
                             <input type="hidden" name="selected_setting_id" value="[% selected_setting_id %]" />
                             <input type="submit" class="btn btn-primary" value="Update Setting" />
                             [% ELSE %]
                             <input type="submit" class="btn btn-primary" value="Save Setting" />
                             [% END %]
                             <a class="cancel" href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS %]&method=[% METHOD %]">Cancel</a>
                         </fieldset>
                    </form>
                [% ELSE %]
                    <div id="toolbar" class="btn-toolbar">
                        <a class="btn btn-default" id="new_automate_marc_import_setting" href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS %]&method=[% METHOD %]&op=add_form"><i class="fa fa-plus"></i> New Automate MARC Import Setting</a>
                    </div>
                    <h1>Automate MARC Import Settings List</h1>
                    [% IF automate_marc_import_plugin_settings_count < 1 %]
                        <div class="alert alert-info" id="dno_servers_message">
                            <p>
                                <em>There are no Automate MARC Import Settings defined.</em><br />
                                To create one, use the <strong>new Automate MARC Import Setting</strong> button above.
                            </p>
                        </div>
                    [% ELSE %]
                        <div class="page-section">
                            <table id="automate_marc_import_setting">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Description</th>
                                        <th>Server</th>
                                        <th>Filename patterns</th>
                                        <th>Profile</th>
                                        <th>Auto-commit</th>
                                        <th>Comments</th>
                                        <th>Record type</th>
                                        <th>Encoding</th>
                                        <th>Format</th>
                                        <th>Parse items</th>
                                        <th>MARC modification template</th>
                                        <th>Matching rule</th>
                                        <th>If match found</th>
                                        <th>If no match</th>
                                        <th>Item handling</th>
                                        <th data-class-name="actions noExport">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    [% FOREACH setting IN automate_marc_import_plugin_settings %]
                                        <tr>
                                            <td id="name_[% setting.id %]"><strong>[% setting.name | html %]</strong></td>
                                            <td id="description_[% setting.id %]">[% IF setting.description %][% setting.description | html %][% ELSE %]<em>(none)</em>[% END %]</td>
                                            <td id="transport_name_[% setting.id %]">[% setting.transport_name %]</td>
                                            <td id="filenames_[% setting.id %]">[% IF setting.filenames %][% setting.filenames | html | html_line_break %][% ELSE %]<em>(default)</em>[% END %]</td>
                                            <td id="profile_name_[% setting.id %]">[% setting.profile_name %]</td>
                                            <td id="auto_commit_[% setting.id %]">[% IF setting.auto_commit %]Yes[% ELSE %]No[% END %]</td>
                                            <td id="profile_comment_[% setting.id %]">[% setting.profile_comment %]</td>
                                            <td id="profile_record_type_[% setting.id %]">[% setting.profile_record_type %]</td>
                                            <td id="profile_character_encoding_[% setting.id %]">[% setting.profile_character_encoding %]</td>
                                            <td id="profile_format_[% setting.id %]">[% setting.profile_format %]</td>
                                            <td id="profile_parse_items_[% setting.id %]">[% IF setting.profile_parse_items %]Yes[% ELSE %]No[% END %]</td>
                                            <td id="profile_marc_modification_template_[% setting.id %]">[% IF setting.profile_marc_modification_template_name %][% setting.profile_marc_modification_template_name %][% ELSE %]<em>(none)</em>[% END %]</td>
                                            <td id="profile_record_matching_rule_[% setting.id %]">[% IF setting.profile_record_matching_rule_name %][% setting.profile_record_matching_rule_name %][% ELSE %]<em>(none)</em>[% END %]</td>
                                            <td id="profile_nomatch_action_[% setting.id %]">[% setting.profile_overlay_action %]</td>
                                            <td id="profile_overlay_action_[% setting.id %]">[% setting.profile_nomatch_action %]</td>
                                            <td id="profile_item_action_[% setting.id %]">[% setting.profile_item_action %]</td>
                                             <td data-class-name="actions noExport">
                                                 <a class="btn btn-default btn-xs" role="button" href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS %]&method=[% METHOD %]&op=edit&selected_setting_id=[% setting.id %]"><i class="fa fa-pencil" aria-hidden="true"></i> Edit</a>
                                                 <a class="btn btn-default btn-xs delete_server" role="button" href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS %]&method=[% METHOD %]&op=delete&selected_setting_id=[% setting.id %]"><i class="fa fa-trash-can" aria-hidden="true"></i> Delete</a>
                                             </td>
                                        </tr>
                                    [% END %]
                                </tbody>
                            </table>
                        </div>
                        <div class="alert alert-info">
                            <p><strong>Note:</strong> Settings with no filename patterns act as the default for that server, applying to any files that don't match a more specific setting.</p>
                        </div>
                    [% END %]
                [% END %]
            </main>
        </div>
        <div class="col-md-2 order-sm-2 order-md-1">
            <aside> [% INCLUDE 'tools-menu.inc' %] </aside>
        </div>

    [% MACRO jsinclude BLOCK %]
        [% Asset.js("js/tools-menu.js") | $raw %]
        [% Asset.js("lib/jquery/plugins/jquery.validate.min.js") | $raw %]
        [% INCLUDE 'select2.inc' %]
        <script>
            $(document).ready(function(){
                const isAddForm = window.location.href.includes('op=add_form');
                const isEditForm = window.location.href.includes('op=edit_form') || window.location.href.includes('op=edit');
                if (!isAddForm && !isEditForm) {
                    return;
                }

                function clearProfileDetails() {
                    $('.profile_details_value').text('');
                }

                function displayProfileDetails(profile, templateNames, matcherNames) {
                    if (!profile) {
                        clearProfileDetails();
                        return;
                    }
                    $('#name').text(profile.name || '');
                    $('#comment').text(profile.comments || '');
                    $('#item_action').text(profile.item_action || '(none)');
                    $('#record_type').text(profile.record_type || '');
                    $('#encoding').text(profile.encoding || '');
                    $('#format').text(profile.format || '');
                    $('#parse_items').text(profile.parse_items ? 'Yes' : 'No');
                    $('#template').text(profile.template_id ? (templateNames[profile.template_id] || '(unknown)') : '(none)');
                    $('#matcher').text(profile.matcher_id ? (matcherNames[profile.matcher_id] || '(unknown)') : '(none)');
                    $('#overlay_action').text(profile.overlay_action || '(none)');
                    $('#nomatch_action').text(profile.nomatch_action || '(none)');
                }

                // Store data for the change handler
                let profilesById = {};
                let templateNames = {};
                let matcherNames = {};

                // Fetch all required data in parallel
                Promise.all([
                    getProfiles(),
                    getTemplates(),
                    getMatchers()
                ]).then(([profiles, templates, matchers]) => {
                    // Build lookup maps
                    profiles.forEach(p => {
                        profilesById[String(p.profile_id)] = p;
                    });
                    templates.forEach(t => {
                        templateNames[t.template_id] = t.name;
                    });
                    matchers.forEach(m => {
                        matcherNames[m.matcher_id] = m.code;
                    });

                    const selectedProfileId = $('#profile_id').val();

                    // Only display profile details if one is already selected (edit form)
                    if (selectedProfileId) {
                        displayProfileDetails(profilesById[selectedProfileId], templateNames, matcherNames);
                    }

                    // Handle profile selection change using Select2 events
                    // Use setTimeout to ensure Select2 has finished initializing
                    setTimeout(function() {
                        $('#profile_id').on('select2:select select2:clear change', function() {
                            const selectedId = $(this).val();
                            displayProfileDetails(selectedId ? profilesById[selectedId] : null, templateNames, matcherNames);
                        });
                    }, 0);
                });

                // Toggle framework options visibility based on auto_commit checkbox
                $('#auto_commit').on('change', function() {
                    if ($(this).is(':checked')) {
                        $('#framework_options').show();
                    } else {
                        $('#framework_options').hide();
                    }
                });
            })

            const getProfiles = () => {
                return $.ajax("/api/v1/import_batch_profiles").then(profiles => profiles);
            }

            const getTemplates = () => {
                return $.ajax("/api/v1/marc_modification_templates").then(templates => templates).catch(() => []);
            }

            const getMatchers = () => {
                return $.ajax("/api/v1/record_matchers").then(matchers => matchers).catch(() => []);
            }
            
            // Add form validation using jQuery Validate (Koha standard)
            $(document).ready(function(){
                // Only apply validation on the add form
                if (window.location.href.includes('op=add_form') || $('#automate_marc_import_form').length) {
                    $('#automate_marc_import_form').validate({
                        rules: {
                            name: {
                                required: true,
                                maxlength: 100
                            },
                            description: {
                                maxlength: 500
                            },
                            selected_transport_id: {
                                required: true
                            },
                            profile_id: {
                                required: true
                            }
                        },
                        messages: {
                            name: {
                                required: "Name is required",
                                maxlength: "Name must be 100 characters or less"
                            },
                            description: {
                                maxlength: "Description must be 500 characters or less"
                            },
                            selected_transport_id: {
                                required: "Transport selection is required"
                            },
                            profile_id: {
                                required: "Profile selection is required"
                            }
                        },
                        errorPlacement: function(error, element) {
                            error.insertAfter(element.next('.required'));
                        },
                        highlight: function(element, errorClass, validClass) {
                            $(element).addClass('error');
                        },
                        unhighlight: function(element, errorClass, validClass) {
                            $(element).removeClass('error');
                        },
                        submitHandler: function(form) {
                            // Prevent double submission
                            if (form.beenSubmitted) {
                                return false;
                            } else {
                                form.beenSubmitted = true;
                                form.submit();
                            }
                        }
                    });
                }
            });
        </script>
    [% END %]
    </div>
[% INCLUDE 'intranet-bottom.inc' %]
