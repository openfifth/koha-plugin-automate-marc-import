[% USE raw %]
[% USE Asset %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title>[% FILTER collapse %]
    [% t("Configuration") | html %] &rsaquo;
    [% t("Automate MARC Import") | html %] &rsaquo;
    [% t("Koha") | html %]
[% END %]</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="plugins_AutomateMarcImport_configure" class="plugins">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'cat-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
        [% END %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS %]&method=tool">Automate MARC Import</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active = 1 %]
            <span>Configuration</span>
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

<div class="main container-fluid">
    <div class="row">
        <div class="col-md-10 order-md-2 order-sm-1">
            <main>
                <h1>Automate MARC Import Configuration</h1>

                [% IF success_message %]
                    <div class="alert alert-success">
                        [% success_message | html %]
                    </div>
                [% END %]

                [% IF error_message %]
                    <div class="alert alert-danger">
                        <strong>Error:</strong> [% error_message | html %]
                    </div>
                [% END %]

                <form method="post" id="configure_form">
                    [% INCLUDE 'csrf-token.inc' %]
                    <input type="hidden" name="class" value="[% CLASS %]"/>
                    <input type="hidden" name="method" value="configure"/>
                    <input type="hidden" name="save" value="1"/>

                    <fieldset class="rows">
                        <legend>Archive Settings</legend>
                        <ol>
                            <li>
                                <label for="archive_retention_count">Archive retention count: </label>
                                <input type="number" name="archive_retention_count" id="archive_retention_count"
                                       value="[% archive_retention_count | html %]"
                                       min="0" max="100" step="1" size="5" />
                                <div class="hint">
                                    Maximum number of archived files to keep per import setting. Oldest files are deleted when this limit is exceeded.
                                </div>
                                <div class="hint">
                                    Set to <strong>0</strong> to disable archiving entirely (processed files will be deleted immediately after staging).
                                </div>
                                <div class="hint">
                                    Default: <strong>10</strong> files. Maximum: <strong>100</strong> files.
                                </div>
                            </li>
                            <li>
                                <label for="archive_failed_retention_count">Failed-import archive retention count: </label>
                                <input type="number" name="archive_failed_retention_count" id="archive_failed_retention_count"
                                       value="[% archive_failed_retention_count | html %]"
                                       min="0" max="100" step="1" size="5" />
                                <div class="hint">
                                    Maximum number of failed-import files to keep per import setting, separately from the successful-import archive above.
                                </div>
                                <div class="hint">
                                    Set to <strong>0</strong> to disable archiving of failed files entirely.
                                </div>
                                <div class="hint">
                                    Default: <strong>10</strong> files. Maximum: <strong>100</strong> files.
                                </div>
                            </li>
                        </ol>
                    </fieldset>

                    <fieldset class="action">
                        <input type="submit" class="btn btn-primary" value="Save Configuration" />
                        <a class="cancel" href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS %]&method=tool">Cancel</a>
                    </fieldset>
                </form>

                <div class="alert alert-info">
                    <h4>About Archive Retention</h4>
                    <p>
                        Successfully imported files are archived to <code>Archive/{setting_id}/Success/</code>, and
                        failed imports are archived separately to <code>Archive/{setting_id}/Failed/</code> so you can
                        tell at a glance which files actually made it into the catalog.
                    </p>
                    <p>
                        Each retention count limits how many archived files are kept per setting, independently for
                        successes and failures. This prevents the archive from growing indefinitely and consuming disk space.
                    </p>
                    <p>
                        <strong>Note:</strong> deduplication no longer depends on these archived files — it's based on
                        a permanent history log, so a low retention count only affects how many files you can inspect
                        on disk, not whether an unchanged file gets re-imported.
                    </p>
                </div>
            </main>
        </div>
        <div class="col-md-2 order-sm-2 order-md-1">
            <aside> [% INCLUDE 'tools-menu.inc' %] </aside>
        </div>
    </div>
</div>

[% MACRO jsinclude BLOCK %]
    [% Asset.js("js/tools-menu.js") | $raw %]
    <script>
        $(document).ready(function(){
            // Client-side validation
            $('#configure_form').on('submit', function(e) {
                var counts = [
                    { id: '#archive_retention_count', label: 'Archive retention count' },
                    { id: '#archive_failed_retention_count', label: 'Failed-import archive retention count' }
                ];

                for (var i = 0; i < counts.length; i++) {
                    var value = $(counts[i].id).val();

                    if (!/^\d+$/.test(value)) {
                        alert(counts[i].label + ' must be a whole number.');
                        e.preventDefault();
                        return false;
                    }

                    var count = parseInt(value, 10);
                    if (count < 0 || count > 100) {
                        alert(counts[i].label + ' must be between 0 and 100.');
                        e.preventDefault();
                        return false;
                    }
                }

                return true;
            });
        });
    </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
